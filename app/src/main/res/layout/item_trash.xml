<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#1A1A1A"
    android:padding="2dp"
    android:layout_margin="2dp">

    <!-- Square thumbnail: height equals width at runtime via SquareImageView logic.
         We use a fixed 110dp height here as a safe default; the adapter overrides
         this at bind time to enforce a 1:1 ratio. -->
    <ImageView
        android:id="@+id/ivThumbnail"
        android:layout_width="match_parent"
        android:layout_height="110dp"
        android:adjustViewBounds="false"
        android:scaleType="centerCrop"
        android:background="#2A2A2A"/>

    <!-- Filename label -->
    <TextView
        android:id="@+id/tvFilename"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="middle"
        android:textColor="#CCCCCC"
        android:textSize="10sp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingTop="4dp"
        android:paddingBottom="2dp"/>

    <!-- Action buttons row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingBottom="2dp">

        <Button
            android:id="@+id/btnRestore"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_weight="1"
            android:text="Restaurar"
            android:textColor="#00C853"
            android:textSize="10sp"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:background="@android:color/transparent"
            android:textStyle="bold"
            android:gravity="center"/>

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#333333"/>

        <Button
            android:id="@+id/btnDeletePermanent"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_weight="1"
            android:text="Eliminar"
            android:textColor="#FF5252"
            android:textSize="10sp"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:background="@android:color/transparent"
            android:gravity="center"/>

    </LinearLayout>

</LinearLayout>
